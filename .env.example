# Kopieer naar apps/web/.env.local en vul in met de waarden van het Supabase-project.
# Staging en productie zijn aparte Supabase-projecten (EU-regio).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...) of, bij oudere projecten, de anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
# Basis-URL van de app, gebruikt voor magic links en e-mailbevestiging.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Alleen server-side. Nooit met NEXT_PUBLIC_ prefixen.
# SUPABASE_SECRET_KEY=<secret-key> (nog niet nodig in fase 1)
# ANTHROPIC_API_KEY=<pas nodig vanaf fase 2>
