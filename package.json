{
  "name": "iassistent",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @iassistent/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "staff:validate": "pnpm --filter @iassistent/staff-engine validate",
    "test:db": "bash scripts/test-db.sh"
  }
}
