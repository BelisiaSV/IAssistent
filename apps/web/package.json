{
  "name": "@iassistent/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "staff:bundle": "pnpm --filter @iassistent/staff-engine run bundle ../../staff ../../apps/web/src/generated/staff.json",
    "dev": "pnpm run staff:bundle && next dev",
    "build": "pnpm run staff:bundle && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "pnpm run staff:bundle && tsc --noEmit",
    "test": "pnpm run staff:bundle && vitest run"
  },
  "dependencies": {
    "@iassistent/db": "workspace:*",
    "@iassistent/staff-engine": "workspace:*",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "exceljs": "4.4.0",
    "html-to-image": "1.11.13",
    "next": "16.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
