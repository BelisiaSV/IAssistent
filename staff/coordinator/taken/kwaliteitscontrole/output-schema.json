{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iassistent.app/staff/coordinator/taken/kwaliteitscontrole/output-schema.json",
  "title": "Kwaliteitscontrole van een weekvoorstel",
  "type": "object",
  "additionalProperties": false,
  "required": ["samenvatting", "criteria", "sterke_punten", "verbeterpunten"],
  "properties": {
    "samenvatting": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600,
      "description": "Eén tot drie zinnen: het oordeel in gewone taal."
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "description": "Precies één score per criterium uit _gedeeld/kwaliteit.json.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "score", "toelichting"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z][a-z_]*$", "maxLength": 40 },
          "score": { "type": "integer", "minimum": 1, "maximum": 5 },
          "toelichting": { "type": "string", "minLength": 1, "maxLength": 400 }
        }
      }
    },
    "sterke_punten": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "verbeterpunten": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterium", "punt"],
        "properties": {
          "criterium": { "type": "string", "pattern": "^[a-z][a-z_]*$", "maxLength": 40 },
          "punt": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    }
  }
}
